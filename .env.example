# Copy to .env and fill in, or write the raw key to ./.elevenlabs_api_key.
# The pipeline also accepts ~/.config/elevenlabs/api_key and an exported
# ELEVENLABS_API_KEY environment variable.
ELEVENLABS_API_KEY=sk_replace_me

# Optional overrides
# FFMPEG=/usr/bin/ffmpeg
# FFPROBE=/usr/bin/ffprobe
# FFMPEG_FONTSDIR=/usr/share/fonts
